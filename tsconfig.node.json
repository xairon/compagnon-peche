{
  "compilerOptions": {
    "composite": true,
    // composite projects must emit. Send the output to a scratch dir instead of
    // letting .js/.d.ts land next to the sources — src/ holds source only.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  // Fichiers partagés : vite.config les consomme au build, et leurs tests les
  // vérifient côté app. Ils doivent être visibles des deux projets.
  //  · csp.ts        — la CSP, comparée aux listes d'hôtes de la carte
  //  · sw-delais.ts  — les délais du service worker, comparés à ceux de fetchT
  //  · net-bornes.ts — dont sw-delais dérive
  //  · manifest.ts   — le manifeste PWA, confronté au contenu réel de public/
  "include": [
    "vite.config.ts",
    "src/lib/csp.ts",
    "src/lib/sw-delais.ts",
    "src/lib/net-bornes.ts",
    "src/lib/manifest.ts"
  ]
}
